        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Vet2026*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function() { pm.response.to.have.status(200); });",
              "if(pm.response.code===200){const x=pm.response.json();pm.collectionVariables.set(\"adminToken\",x.token);pm.collectionVariables.set(\"token\",x.token);}"
